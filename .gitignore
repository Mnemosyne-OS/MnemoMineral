# Harvested COD metadata: ~300 MB of CSV, regenerated by scripts/harvest-cod.mjs.
# Public-domain source data, cheap to refetch, pointless in git history.
data/cod-raw/

# Downloaded CIFs, cached so a rebuild does not re-hit a public academic server.
data/cif-cache/

# Derived: rebuilt by scripts/build-catalogue.mjs from the two above.
data/catalogue.json

